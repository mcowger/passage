{
  "name": "passage",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/run-dev.ts",
    "dev:stop": "env -u PASSAGE_DB_PATH -u PASSAGE_SESSIONS_ROOT -u PASSAGE_PID_FILE -u PASSAGE_SHUTDOWN_TIMEOUT_MINUTES -u PASSAGE_MAX_ACTIVE_AGENTS bun scripts/dev-stop.ts",
    "stop": "env -u PASSAGE_DB_PATH -u PASSAGE_SESSIONS_ROOT -u PASSAGE_PID_FILE -u PASSAGE_SHUTDOWN_TIMEOUT_MINUTES -u PASSAGE_MAX_ACTIVE_AGENTS bun scripts/dev-stop.ts",
    "frpc": "bun run scripts/run-frpc.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun --cwd dist run ./index.js",
    "package": "bun run scripts/build.ts --compile",
    "build:linux": "bun run scripts/build.ts --compile --target=bun-linux-x64-modern --outfile=./dist/passage-linux-x64",
    "deploy": "bun run scripts/deploy.ts",
    "test": "bun test --dots",
    "test:gate": "bun run tests/gate.ts",
    "test:pi-rpc": "bun test tests/pi-rpc",
    "test:pi-live": "bun run tests/pi-rpc/run-live.ts",
    "test:pty-websocket": "bun test tests/pty-websocket",
    "test:pty-live": "bun run tests/pty-websocket/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@logtape/hono": "^2.2.8",
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.0.5",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "codemirror": "^6.0.2",
    "fuzzysort": "^4.0.2",
    "hono": "4.13.5",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-material-vscode-icons": "0.1.0",
    "react-resizable-panels": "^4",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.3.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "nullmodel": "github:alexcollins/NullModel",
    "shadcn": "^4.21.0",
    "typescript": "5.9.3"
  }
}
