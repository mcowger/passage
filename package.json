{
  "name": "passage",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/daemon/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun --cwd dist run ./index.js",
    "package": "bun build --compile --target=bun --production --outfile=dist/passage ./src/daemon/index.ts",
    "smoke:development": "bun run tests/smoke/server-smoke.ts --source",
    "smoke:production": "bun run tests/smoke/server-smoke.ts",
    "smoke:package": "bun run tests/smoke/server-smoke.ts --compiled",
    "test": "bun test",
    "test:gate": "bun run tests/gate.ts",
    "test:pi-rpc": "bun test tests/pi-rpc",
    "test:pi-live": "bun run tests/pi-rpc/run-live.ts",
    "test:pty-websocket": "bun test tests/pty-websocket",
    "test:pty-live": "bun run tests/pty-websocket/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "codemirror": "^6.0.2",
    "hono": "4.13.5",
    "lucide-react": "^1.43.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-material-vscode-icons": "0.1.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "nullmodel": "github:alexcollins/NullModel",
    "shadcn": "^4.21.0",
    "typescript": "5.9.3"
  }
}
