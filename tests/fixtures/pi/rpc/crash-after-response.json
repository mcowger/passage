{
  "name": "crash-after-response",
  "scenario": "synthetic",
  "note": "SYNTHETIC: replayer exits 1 with stderr after the prompt step; no live kill was needed",
  "steps": [
    {
      "expect": {
        "type": "get_state"
      },
      "respond": {
        "id": "$id",
        "type": "response",
        "command": "get_state",
        "success": true,
        "data": {
          "model": {
            "id": "muse-spark-1.3",
            "name": "Muse Spark 1.3",
            "api": "openai-responses",
            "provider": "plexus",
            "baseUrl": "https://fixture-model.local/v1",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0.1,
              "output": 0.2,
              "cacheRead": 0.002,
              "cacheWrite": 0
            },
            "contextWindow": 1048564,
            "maxTokens": 32000
          },
          "thinkingLevel": "high",
          "isStreaming": false,
          "isCompacting": false,
          "steeringMode": "one-at-a-time",
          "followUpMode": "one-at-a-time",
          "sessionFile": "$sessionDir/$sessionId.jsonl",
          "sessionId": "$sessionId",
          "autoCompactionEnabled": true,
          "messageCount": 0,
          "pendingMessageCount": 0
        }
      }
    },
    {
      "expect": {
        "type": "prompt"
      },
      "respond": {
        "type": "response",
        "id": "$id",
        "command": "prompt",
        "success": true
      },
      "emit": [
        {
          "type": "agent_start"
        }
      ]
    }
  ],
  "stderrLines": [
    "[pi-rpc] fatal: simulated crash",
    "Error: connection reset"
  ],
  "exitCode": 1
}
